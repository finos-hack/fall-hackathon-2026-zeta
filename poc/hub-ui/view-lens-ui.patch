+import { fireEvent, render, screen, waitFor } from '@testing-library/react';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { CodeBlock } from './CodeBlock.js';
+import { MarkdownBlock } from './MarkdownBlock.js';
+
+const JSON = '{\n  "name": "shop",\n  "open": true,\n  "retry": null,\n  "limit": 3\n}';
+
+afterEach(() => vi.restoreAllMocks());
+
+describe('CodeBlock', () => {
+    it('colours JSON keys, strings, numbers and keywords', () => {
+        const { container } = render(<CodeBlock code={JSON} language="json" />);
+        expect(container.querySelector('.codeblock-key')).toHaveTextContent('"name"');
+        expect(container.querySelector('.codeblock-string')).toHaveTextContent('"shop"');
+        expect(container.querySelector('.codeblock-number')).toHaveTextContent('3');
+        expect(container.querySelector('.codeblock-keyword')).toHaveTextContent('true');
+    });
+
+    it('leaves other languages plain', () => {
+        const { container } = render(<CodeBlock code={'key=value'} language="ini" />);
+        expect(container.querySelector('.codeblock-key')).toBeNull();
+        expect(container.querySelector('pre')).toHaveTextContent('key=value');
+    });
+
+    it('copies the code to the clipboard', async () => {
+        const writeText = vi.fn().mockResolvedValue(undefined);
+        Object.defineProperty(navigator, 'clipboard', { value: { writeText }, configurable: true });
+        render(<CodeBlock code={JSON} language="json" />);
+        fireEvent.click(screen.getByRole('button', { name: 'Copy' }));
+        await waitFor(() => expect(writeText).toHaveBeenCalledWith(JSON));
+        expect(await screen.findByRole('button', { name: 'Copied' })).toBeInTheDocument();
+    });
+
+    it('expands into a dialog that Escape and the backdrop close', () => {
+        render(<CodeBlock code={JSON} language="json" />);
+        fireEvent.click(screen.getByRole('button', { name: 'Expand' }));
+        const dialog = screen.getByRole('dialog', { name: 'Code viewer' });
+        expect(dialog).toHaveTextContent('"limit"');
+        fireEvent.keyDown(document, { key: 'Escape' });
+        expect(screen.queryByRole('dialog', { name: 'Code viewer' })).toBeNull();
+        fireEvent.click(screen.getByRole('button', { name: 'Expand' }));
+        fireEvent.click(screen.getByRole('dialog', { name: 'Code viewer' }));
+        expect(screen.queryByRole('dialog', { name: 'Code viewer' })).toBeNull();
+    });
+
+    it('renders fenced blocks as a viewer and keeps inline code inline', () => {
+        const { container } = render(
+            <MarkdownBlock text={'Copy it into a `*.calm-view.json` to reuse it.\n\n```json\n{"a": 1}\n```'} headingLevel={4} />
+        );
+        expect(screen.getByRole('button', { name: 'Expand' })).toBeInTheDocument();
+        expect(container.querySelector('.codeblock-key')).toHaveTextContent('"a"');
+        const inline = container.querySelector('p code');
+        expect(inline).toHaveTextContent('*.calm-view.json');
+    });
+});
diff --git a/calm-hub-ui/src/extensions/blocks/CodeBlock.tsx b/calm-hub-ui/src/extensions/blocks/CodeBlock.tsx
new file mode 100644
index 00000000..d3f42eb6
--- /dev/null
+++ b/calm-hub-ui/src/extensions/blocks/CodeBlock.tsx
@@ -0,0 +1,120 @@
+import { useEffect, useId, useRef, useState, type ReactNode } from 'react';
+import './CodeBlock.css';
+
+const TOKEN = /("(?:\\.|[^"\\])*")(\s*:)?|\b(true|false|null)\b|-?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?/g;
+
+type Part = { text: string; kind?: 'key' | 'string' | 'number' | 'keyword' };
+
+/** Splits JSON source into coloured parts. Anything the pattern misses stays plain text. */
+function tokenize(source: string): Part[] {
+    const parts: Part[] = [];
+    let at = 0;
+    TOKEN.lastIndex = 0;
+    for (let match = TOKEN.exec(source); match !== null; match = TOKEN.exec(source)) {
+        if (match.index > at) parts.push({ text: source.slice(at, match.index) });
+        const [text, quoted, colon, keyword] = match;
+        parts.push({
+            text,
+            kind: quoted ? (colon !== undefined ? 'key' : 'string') : keyword !== undefined ? 'keyword' : 'number',
+        });
+        at = match.index + text.length;
+    }
+    if (at < source.length) parts.push({ text: source.slice(at) });
+    return parts;
+}
+
+function highlighted(source: string, keyPrefix: string): ReactNode {
+    return tokenize(source).map((part, index) =>
+        part.kind === undefined ? (
+            <span key={`${keyPrefix}-${index}`}>{part.text}</span>
+        ) : (
+            <span key={`${keyPrefix}-${index}`} className={`codeblock-${part.kind}`}>
+                {part.text}
+            </span>
+        )
+    );
+}
+
+async function copyText(text: string): Promise<boolean> {
+    try {
+        await navigator.clipboard.writeText(text);
+        return true;
+    } catch {
+        // The clipboard API is missing or refused: fall back to a selected textarea.
+        try {
+            const area = document.createElement('textarea');
+            area.value = text;
+            document.body.append(area);
+            area.select();
+            const done = document.execCommand('copy');
+            area.remove();
+            return done;
+        } catch {
+            return false;
+        }
+    }
+}
+
+/** A fenced code block with syntax colours, a copy button and a larger modal view. */
+export function CodeBlock({ code, language }: { code: string; language?: string }) {
+    const [expanded, setExpanded] = useState(false);
+    const [copied, setCopied] = useState(false);
+    const closeRef = useRef<HTMLButtonElement>(null);
+    const uid = useId().replace(/[^A-Za-z0-9_-]/g, '');
+    const json = (language ?? '').toLowerCase() === 'json';
+    const body = json ? highlighted(code, uid) : code;
+
+    useEffect(() => {
+        if (!expanded) return;
+        closeRef.current?.focus();
+        const onKey = (event: KeyboardEvent) => {
+            if (event.key === 'Escape') setExpanded(false);
+        };
+        document.addEventListener('keydown', onKey);
+        return () => document.removeEventListener('keydown', onKey);
+    }, [expanded]);
+
+    const copy = async () => {
+        if (await copyText(code)) {
+            setCopied(true);
+            window.setTimeout(() => setCopied(false), 1500);
+        }
+    };
+
+    return (
+        <>
+            <div className="codeblock">
+                <div className="codeblock-bar">
+                    <button type="button" className="btn btn-ghost btn-xs" onClick={copy}>
+                        {copied ? 'Copied' : 'Copy'}
+                    </button>
+                    <button type="button" className="btn btn-ghost btn-xs" onClick={() => setExpanded(true)} aria-haspopup="dialog">
+                        Expand
+                    </button>
+                </div>
+                <pre className="codeblock-pre">
+                    <code>{body}</code>
+                </pre>
+            </div>
+            {expanded && (
+                <div className="codeblock-dialog" role="dialog" aria-modal="true" aria-label="Code viewer" onClick={() => setExpanded(false)}>
+                    <div className="codeblock codeblock-frame" onClick={(event) => event.stopPropagation()}>
+                        <div className="codeblock-bar">
+                            <button type="button" className="btn btn-ghost btn-xs" onClick={copy}>
+                                {copied ? 'Copied' : 'Copy'}
+                            </button>
+                            <button type="button" ref={closeRef} className="btn btn-ghost btn-xs" onClick={() => setExpanded(false)}>
+                                Close
+                            </button>
+                        </div>
+                        <div className="codeblock-body">
+                            <pre className="codeblock-pre codeblock-pre-large">
+                                <code>{json ? highlighted(code, `${uid}-large`) : code}</code>
+                            </pre>
+                        </div>
+                    </div>
+                </div>
+            )}
+        </>
+    );
+}
