    "integration-developers",
    "partner-managers"
  ],
  "suggested-formats": [
    "svg",
    "json",
    "markdown"
  ],
  "for": "../model/fluxnova-kyc-onboarding.architecture.json",
  "filter": {
    "nodes": [
      "kyc-fluxnova-engine",
      "kyc-fluxnova-rest-api",
      "kyc-identity-verification-svc",
      "kyc-sanctions-screening-svc",
      "kyc-risk-scoring-svc",
      "kyc-document-mgmt-svc",
      "kyc-notification-svc",
      "kyc-crm-sync-svc",
      "kyc-watchlist-provider",
      "kyc-idv-provider"
    ],
    "relationships": [
      "kyc-rest-api-to-engine",
      "kyc-engine-to-idv-svc",
      "kyc-engine-to-sanctions-svc",
      "kyc-engine-to-risk-scoring",
      "kyc-engine-to-doc-mgmt",
      "kyc-engine-to-notification",
      "kyc-engine-to-crm-sync",
      "kyc-idv-svc-to-idv-provider",
      "kyc-sanctions-svc-to-watchlist"
    ]
  }
}
