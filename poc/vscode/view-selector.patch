+    /** Decorator summaries for a view filter; unreadable files are skipped. */
+    private async readViewDecorators(
+        viewDir: string,
+        filter: unknown
+    ): Promise<ListedCalmView['decorators']> {
+        const out: ListedCalmView['decorators'] = [];
+        const ids = (filter as Record<string, unknown> | null)?.['decorators'];
+        if (!Array.isArray(ids)) return out;
+        for (const id of ids) {
+            if (typeof id !== 'string') continue;
+            const decoPath = nodePath.join(viewDir, `${id}.decorator.json`);
+            try {
+                const raw = await vscode.workspace.fs.readFile(vscode.Uri.file(decoPath));
+                const d = JSON.parse(Buffer.from(raw).toString('utf8')) as Record<
+                    string,
+                    unknown
+                >;
+                const data = (d['data'] as Record<string, unknown> | undefined) ?? {};
+                const str = (x: unknown): string | undefined =>
+                    typeof x === 'string' ? x : undefined;
+                out.push({
+                    uniqueId: id,
+                    type: str(d['type']),
+                    reviewed: str(d['reviewed']) ?? str(data['reviewed']),
+                    outcome: str(d['outcome']) ?? str(data['outcome']),
+                    appliesTo: Array.isArray(d['applies-to'])
+                        ? (d['applies-to'] as unknown[]).filter((a): a is string => typeof a === 'string')
+                        : undefined,
+                });
+            } catch (err) {
+                this.log.appendLine(
+                    `[CanvasPanel] view decorator unreadable: ${decoPath} (${err instanceof Error ? err.message : String(err)})`
+                );
+                continue;
+            }
+        }
+        this.log.appendLine(
+            `[CanvasPanel] view decorators resolved: ${out.length} from ${viewDir}`
+        );
+        return out;
+    }
+
+    /** List workspace sidecars (`*.calm-view.json`) selecting the open document. */
+    private async sendWorkspaceViews(): Promise<void> {
+        const docPath = this.currentDocument?.uri.fsPath;
+        if (!docPath) {
+            this.postMessage({ type: 'viewsListed', views: [] });
+            return;
+        }
+        const views: ListedCalmView[] = [];
+        const uris = await vscode.workspace.findFiles('**/*.calm-view.json');
+        for (const uri of uris) {
+            try {
+                const raw = await vscode.workspace.fs.readFile(uri);
+                const v = JSON.parse(Buffer.from(raw).toString('utf8')) as Record<
+                    string,
+                    unknown
+                >;
+                if (!v || typeof v !== 'object' || !v['unique-id'] || !v['filter']) {
+                    continue;
+                }
+                const target =
+                    typeof v['for'] === 'string'
+                        ? nodePath.normalize(nodePath.join(nodePath.dirname(uri.fsPath), v['for']))
+                        : '';
+                if (target !== docPath) continue;
+                const dir = nodePath.dirname(uri.fsPath);
+                const decorators = await this.readViewDecorators(dir, v['filter']);
+                views.push({
+                    uniqueId: v['unique-id'] as string,
+                    name: (v['name'] as string) ?? (v['unique-id'] as string),
+                    audience: Array.isArray(v['audience'])
+                        ? (v['audience'] as string[]).filter((a) => typeof a === 'string')
+                        : [],
+                    filter: (v['filter'] as Record<string, unknown>) ?? {},
+                    decorators,
+                    drillDown: (v['drill-down'] as Record<string, string> | undefined) ?? {},
+                    ...(typeof v['group'] === 'string' ? { group: v['group'] as string } : {}),
+                    ...(v['derived-from'] ? { derived: true } : {}),
+                });
+            } catch {
+                continue;
+            }
+        }
+        this.postMessage({ type: 'viewsListed', views });
     }
 
