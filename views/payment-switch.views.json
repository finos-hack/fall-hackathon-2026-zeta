{
  "$schema": "https://calm.finos.org/draft/2026-11/meta/view.json",
  "$id": "https://github.com/finos-hack/fall-hackathon-2026-zeta/views/payment-switch.views.json",
  "title": "fluxrig payment switch views",
  "description": "Named views over fluxrig/calm-models payment-switch, following finos/architecture-as-code#2344. One model, three readers.",
  "views": [
    {
      "unique-id": "deployment-view",
      "name": "Deployment View",
      "description": "Where racks and mixer run and how they connect. Hides terminals and scheme detail.",
      "audience": "Platform engineers and SREs",
      "filter": {
        "nodes": ["region-east", "region-west", "rack-east", "rack-west", "mixer"],
        "relationships": ["region-east-contains-rack-east", "region-west-contains-rack-west", "region-east-contains-mixer", "mixer-to-rack-east", "mixer-to-rack-west", "rack-east-to-rack-west", "rack-west-to-rack-east"],
        "node-types": ["fluxrig:region", "fluxrig:rack", "fluxrig:mixer"],
        "decorators": ["fluxrig-deployment-facts"]
      }
    },
    {
      "unique-id": "integration-view",
      "name": "Integration View",
      "description": "POS terminals, racks and scheme endpoints with their wires. Hides regions and mixer.",
      "audience": "Solution architects and developers",
      "filter": {
        "nodes": ["rack-east", "rack-west", "pos-terminals-east", "pos-terminals-west", "scheme-a-east", "scheme-a2-east", "scheme-b-east", "scheme-a-west", "scheme-b-west"],
        "relationships": ["pos-terminals-east-interacts-rack-east", "rack-east-to-pos-terminals-east", "rack-east-to-scheme-a-east", "scheme-a-east-to-rack-east", "rack-east-to-scheme-a2-east", "scheme-a2-east-to-rack-east"],
        "node-types": ["fluxrig:rack", "actor", "system"],
        "decorators": ["fluxrig-deployment-facts"]
      }
    },
    {
      "unique-id": "audit-view",
      "name": "Audit View",
      "description": "External counterparties and deployment facts an auditor reads. No internal gear detail. Controls list is empty in calm-models today, so this view carries the evidence available: sockets, regions and outbound-only links.",
      "audience": "Auditors and risk reviewers",
      "filter": {
        "nodes": ["pos-terminals-east", "pos-terminals-west", "scheme-a-east", "scheme-a2-east", "scheme-b-east", "scheme-a-west", "scheme-b-west", "rack-east", "rack-west"],
        "relationships": ["rack-east-to-scheme-a-east", "scheme-a-east-to-rack-east", "rack-east-to-scheme-a2-east", "scheme-a2-east-to-rack-east"],
        "node-types": ["actor", "system", "fluxrig:rack"],
        "controls": [],
        "decorators": ["fluxrig-deployment-facts", "fluxrig-gear-placement-facts"]
      }
    }
  ]
}
